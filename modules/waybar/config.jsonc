{
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "modules-left":   ["hyprland/workspaces"],
  "modules-center": ["custom/clock"],
  "modules-right":  ["pulseaudio", "network", "tray"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "active-only": false
  },

  // Time by default; flips to the full date while the AGS control center is open.
  // AGS owns the mode (it writes ~/.cache/waybar-clock-mode and signals us) so the
  // clock stays in lockstep with the sidebar however it was toggled — clock click
  // or the Super+C keybind. Built-in "clock" can't be driven externally, hence a
  // custom module.
  "custom/clock": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/clock.sh",
    "interval": 10,
    "signal": 8,
    "on-click": "ags toggle sidebar"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pwvucontrol"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Connected",
    "format-disconnected": "󰤭 Offline",
    "tooltip-format": "{ifname}: {ipaddr}"
  },

  "tray": {
    "spacing": 8
  }
}
